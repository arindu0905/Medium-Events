# Copy to supabase/.env.local (git-ignored) and fill in. Never commit or share the real file.
# Project Settings > API > Project URL
SUPABASE_URL="https://<project-ref>.supabase.co"
# Project Settings > API > service_role key. MASTER KEY: paste it here yourself, never in chat.
SUPABASE_SERVICE_ROLE_KEY=""
# Project Settings > General > Reference ID. Seed scripts refuse to run against any other project.
DEV_PROJECT_REF="<project-ref>"
# Database password chosen when the project was created (used by `supabase db push`)
SUPABASE_DB_PASSWORD=""
# Password given to the seeded test users (test-admin@medium.test etc.). At least 10 characters.
TEST_USER_PASSWORD=""
